PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
UNIVERSITY_NAME=Rishihood University
UNIVERSITY_DOMAINS=nst.rishihood.edu.in,csds.rishihood.edu.in,psy.rishihood.edu.in,makers.rishihood.edu.in,rishihood.edu.in
# Web application client ID from Google Auth Platform > Clients (not a secret).
# Once set, only Google login is accepted, including in development.
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAINS=nst.rishihood.edu.in,csds.rishihood.edu.in,psy.rishihood.edu.in,makers.rishihood.edu.in,rishihood.edu.in
# Local development only: codes are returned to the local sign-in screen.
DEV_AUTH=true
SEED_DEMO=true
# Production: NODE_ENV=production, DEV_AUTH=false, SEED_DEMO=false
# GOOGLE_CLIENT_ID enables Google authentication without SMTP.
# Render Free: use Turso and Cloudinary. See docs/DEPLOYMENT.md.
# Keep these blank for local SQLite and local photo storage.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Same random value (at least 32 characters) as Vercel. Blank locally.
API_PROXY_SECRET=
# Every student must connect to the same backend and cloud database.
# Only for local development or a host with an actual persistent disk:
# DATABASE_PATH=/absolute/persistent/path/marketplace.sqlite
# UPLOADS_PATH=/absolute/persistent/path/uploads
# Optional OTP on other hosts. Render Free blocks SMTP; use Google there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated institutional email addresses; no admin by default.
ADMIN_EMAILS=
# Optional seller alerts via Brevo's HTTPS API (works on Render Free).
# Enable only after verifying the sender and activating transactional email.
MESSAGE_EMAIL_ENABLED=false
MESSAGE_EMAIL_FROM=
BREVO_API_KEY=
# Vercel daily scheduler only; generate a random value of at least 32 characters.
CRON_SECRET=
