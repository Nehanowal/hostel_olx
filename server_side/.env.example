PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
UNIVERSITY_NAME=Rishihood University
UNIVERSITY_DOMAINS=nst.rishihood.edu.in,csds.rishihood.edu.in,psy.rishihood.edu.in,makers.rishihood.edu.in,rishihood.edu.in
# Web application client ID from Google Auth Platform > Clients (not a secret).
# Once set, only Google login is accepted, including in development.
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAINS=nst.rishihood.edu.in,csds.rishihood.edu.in,psy.rishihood.edu.in,makers.rishihood.edu.in,rishihood.edu.in
# Local development only: codes are returned to the local sign-in screen.
DEV_AUTH=true
SEED_DEMO=true
# Production: NODE_ENV=production, DEV_AUTH=false, SEED_DEMO=false
# GOOGLE_CLIENT_ID enables Google authentication without SMTP.
# Every student must connect to the same backend with persistent storage.
# DATABASE_PATH=/absolute/persistent/path/marketplace.sqlite
# UPLOADS_PATH=/absolute/persistent/path/uploads
# Configure a free SMTP account for real OTP delivery. Never commit credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Comma-separated institutional email addresses; no admin by default.
ADMIN_EMAILS=
